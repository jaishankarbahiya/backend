PORT=6000
MONGO_URI=mongodb://127.0.0.1:27017/merchant_simulator

# --- MoneyFlow gateway (the API from your docs) ---
GATEWAY_BASE_URL=http://localhost:5000/api/v1
GATEWAY_API_KEY=YOUR_API_KEY
GATEWAY_API_SECRET=YOUR_API_SECRET
# Adjust to your real status route path
GATEWAY_STATUS_PATH=/payments/status/{id}

# frontend origin allowed to call this backend
CORS_ORIGIN=http://localhost:5173
